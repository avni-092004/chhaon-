<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CHHAON (छाँव) — 100% Pure Veg Garden Café | Greater Noida</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        chhaon: {
                            dark: '#1c2826',
                            terra: '#c67d5a',
                            timber: '#7c5c43',
                            sage: '#a3b18a',
                            sagelight: '#e6ede6',
                            cream: '#faf8f5',
                            sand: '#e8e3d9',
                            veg: '#2d5a27'
                        }
                    },
                    fontFamily: {
                        serif: ['"DM Serif Display"', 'serif'],
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        .glass-nav {
            background: rgba(28, 40, 38, 0.94);
            backdrop-filter: blur(14px);
        }
        .hero-bg {
            background: linear-gradient(180deg, rgba(28, 40, 38, 0.82) 0%, rgba(28, 40, 38, 0.94) 100%),
                        url('https://images.unsplash.com/photo-1543007630-9710e4a00a20?auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;
        }
        /* FSSAI-style Pure Veg Indicator */
        .veg-mark {
            width: 16px;
            height: 16px;
            border: 2px solid #2d5a27;
            border-radius: 3px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            background-color: #ffffff;
        }
        .veg-mark::after {
            content: '';
            width: 8px;
            height: 8px;
            background-color: #2d5a27;
            border-radius: 50%;
        }
        .veg-mark-sm {
            width: 13px;
            height: 13px;
            border-width: 1.75px;
        }
        .veg-mark-sm::after {
            width: 6px;
            height: 6px;
        }
        /* Map pin pulse animation */
        @keyframes softPulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.06); }
        }
        .map-node-active {
            animation: softPulse 2.4s infinite ease-in-out;
        }
        @media print {
            body * {
                visibility: hidden;
            }
            #printable-receipt, #printable-receipt * {
                visibility: visible;
            }
            #printable-receipt {
                position: fixed;
                left: 0;
                top: 0;
                width: 100%;
                background: #ffffff !important;
                color: #1c2826 !important;
                padding: 24px !important;
            }
        }
    </style>
</head>
<body class="bg-chhaon-cream text-slate-800 font-sans antialiased selection:bg-chhaon-terra selection:text-white pb-24 sm:pb-8">

