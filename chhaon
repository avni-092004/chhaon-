                        <span class="hidden sm:inline">Ticket</span>
                        <span id="nav-cart-badge" class="bg-chhaon-dark text-chhaon-cream text-xs font-bold px-2 py-0.5 rounded-full">0</span>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="relative min-h-[84vh] flex items-center justify-center text-center pt-14 px-4 hero-bg">
        <div class="max-w-4xl mx-auto py-14 z-10">
            <div class="inline-flex items-center gap-2 bg-chhaon-veg/95 text-chhaon-cream border border-chhaon-sage/35 px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-widest mb-6">
                <span class="veg-mark veg-mark-sm"></span>
                Greater Noida's 100% Pure Veg Sanctuary
